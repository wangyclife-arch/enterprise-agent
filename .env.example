# ============================================================
# 环境变量模板：复制为 .env 后填入自己的密钥
#   cp .env.example .env
# .env 已在 .gitignore 中，不会被提交
# ============================================================

# ---------- LLM（OpenAI 兼容接口）----------
# 可用 DeepSeek 官方、阿里云百炼或任意兼容 OpenAI 协议的网关
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=

# ---------- Embedding ----------
# 输出维度必须与 EMBEDDING_DIM 一致，否则向量入库报错
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_DIM=1024

# ---------- Rerank（可选，不可用时自动降级）----------
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_BASE_URL=https://api.siliconflow.cn/v1/rerank
USE_RERANK=1

# ---------- 检索策略 ----------
# 1 = 向量召回 + BM25 关键词召回，经 RRF 融合；0 = 仅向量召回
USE_HYBRID=1

# ---------- 数据库（PostgreSQL + pgvector）----------
# 云端（如 Neon）：postgresql+psycopg://user:pass@host/db?sslmode=require
# 必须保留 +psycopg 驱动前缀
DATABASE_URL=postgresql+psycopg://ai:ai123456@localhost:5432/ai_assistant

# ---------- 鉴权 ----------
# 生产环境务必替换为随机字符串（例如 openssl rand -hex 20）
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=1440
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---------- 日志 ----------
LOG_LEVEL=INFO

# ---------- LangSmith 追踪（可选）----------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=enterprise-agent